<?xml version="1.0"?>
<ruleset name="mapik/dbase">
    <description>PSR-12, because this is a library rather than a CakePHP application.</description>

    <file>src/</file>
    <file>tests/</file>
    <file>dbase.inc.php</file>

    <arg name="colors"/>
    <arg value="p"/>

    <rule ref="PSR12"/>

    <!--
        The method names are the extension's own, spelled the way the manual spells them. They
        are what this package exists to provide, so they cannot be camelCased.
    -->
    <rule ref="PSR1.Methods.CamelCapsMethodName.NotCamelCaps">
        <severity>0</severity>
    </rule>
</ruleset>
