# syntax=docker/dockerfile:1

FROM php:8.5-cli-alpine

# The extension itself, because a stand-in is only worth what it can be held against. The parity
# tests skip themselves where it is missing, which is also how they behave on a runner without it.
RUN set -x \
 && apk add -U --no-cache --virtual .build-deps autoconf gcc libc-dev make \
 && CPPFLAGS="-DHAVE_SYS_FILE_H" pecl install dbase \
 && docker-php-ext-enable dbase \
 && apk del .build-deps

# What composer needs to fetch a package as a zip rather than cloning it
RUN apk add -U --no-cache git unzip

COPY --from=composer:latest /usr/bin/composer /usr/local/bin/composer

WORKDIR /app
