{
    "name": "mapik/dbase",
    "description": "A pure PHP implementation of the dBase functions, standing in for ext-dbase where it cannot be installed",
    "type": "library",
    "homepage": "https://github.com/Mapiiik/dbase",
    "keywords": [
        "dbase",
        "dbf",
        "polyfill"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "donfbecker",
            "homepage": "https://github.com/donfbecker/dbase"
        },
        {
            "name": "Martin Patocka",
            "homepage": "https://github.com/Mapiiik"
        }
    ],
    "support": {
        "issues": "https://github.com/Mapiiik/dbase/issues",
        "source": "https://github.com/Mapiiik/dbase"
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "suggest": {
        "ext-dbase": "The extension itself is faster. This package steps aside when it is loaded."
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "cs-check": "phpcs",
        "cs-fix": "phpcbf"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Mapik\\DBase\\": "src/"
        },
        "files": [
            "dbase.inc.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Mapik\\DBase\\Tests\\": "tests/"
        }
    }
}
